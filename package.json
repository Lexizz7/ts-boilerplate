{
  "name": "ts-boilerplate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/main.ts",
    "start": "tsdown && node dist/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check --write",
    "format": "biome format --write",
    "ci": "pnpm typecheck && biome check && pnpm test"
  },
  "imports": {
    "#lib/*": "./src/lib/*.ts"
  },
  "dependencies": {
    "dayjs": "^1.11.21",
    "dotenv": "^17.0.0",
    "neverthrow": "^8.2.0",
    "pino": "^10.0.0",
    "undici": "^8.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^24.0.0",
    "lefthook": "^1.10.0",
    "pino-pretty": "^11.0.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
